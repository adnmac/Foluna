{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale : commandes de Foluna, choix de fichiers et de dossiers, notifications, affichage d'un fichier dans l'Explorateur, ouverture de la page de téléchargement d'une nouvelle version.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "notification:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/adnmac/Foluna/*"
        },
        {
          "url": "https://github.com/adnmac/foluna/*"
        }
      ]
    }
  ]
}
