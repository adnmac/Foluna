{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foluna",
  "version": "0.1.0",
  "identifier": "be.adnmac.foluna",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foluna",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "adnmac",
    "homepage": "https://foluna.app",
    "category": "Utility",
    "shortDescription": "Bibliothèque de livres pour liseuse",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English",
          "Dutch",
          "German",
          "Spanish"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      }
    }
  }
}
